{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "fetch_mlb_stats.py",
      "requirements.txt",
      "SETUP_FIREBASE.md",
      "SETUP_GITHUB.md",
      "fg_cookie.txt",
      ".github/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  }
}
