{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/*.py",
      "**/*.bat",
      "requirements.txt",
      "SETUP_FIREBASE.md",
      "SETUP_GITHUB.md",
      "fg_cookie.txt",
      ".github/**",
      "__pycache__/**",
      "*.md",
      ".gitignore",
      ".git/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  }
}
